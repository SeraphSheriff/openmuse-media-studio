#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1
[ -f .env ] && set -a && . ./.env && set +a
export CPK_INTELLIGENCE_API_KEY="${CPK_INTELLIGENCE_API_KEY:-local-studio-mode}"
AGENT_NAME="${OPENMUSE_AGENT_NAME:-OpenMuse Studio}"
COMFY_PATH="${COMFYUI_DIR:-$HOME/ComfyUI}"

setsid pnpm dev </dev/null > api.log 2>&1 &
sleep 1
setsid pnpm dev:web </dev/null > web.log 2>&1 &
sleep 1
setsid pnpm dev:browser </dev/null > browser.log 2>&1 &
if [ -d "$COMFY_PATH" ]; then
  cd "$COMFY_PATH" && setsid ./venv/bin/python main.py --listen 127.0.0.1 --port 8188 --enable-manager --reserve-vram 5.5 --cache-none --disable-pinned-memory </dev/null > comfy.log 2>&1 &
fi
disown -a 2>/dev/null || true
echo "$AGENT_NAME + ComfyUI started: OpenMuse (:8081), ComfyUI (:8188)"
